{
  "name": "youtube-floating-view",
  "version": "1.0.0",
  "description": "Vivaldi-inspired Picture-in-Picture (PiP) Chrome Extension for YouTube and HTML5 videos",
  "type": "module",
  "scripts": {
    "dev": "node -r ./patch-fs.cjs ./node_modules/vite/bin/vite.js build --watch --mode development",
    "build": "node -r ./patch-fs.cjs ./node_modules/vite/bin/vite.js build",
    "test": "node tests/extension.test.js",
    "preview": "node -r ./patch-fs.cjs ./node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "lucide-vue-next": "^0.477.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
